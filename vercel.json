{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/files/upload",
      "destination": "/api/files/upload"
    },
    {
      "source": "/api/files/:id",
      "destination": "/api/files/[id]"
    },
    {
      "source": "/api/files/:id/raw",
      "destination": "/api/files/[id]/raw"
    },
    {
      "source": "/api/files/history",
      "destination": "/api/files/history"
    },
    {
      "source": "/f/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
